APP_ENV=development
# Leave blank to select DB_BACKEND; explicit DATABASE_URL takes precedence on the host.
DATABASE_URL=
DB_BACKEND=sqlite
POSTGRES_HOST=localhost
POSTGRES_DB=company_ai
POSTGRES_USER=company_ai
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional explicit DSN for containers; otherwise DB_BACKEND/POSTGRES_* are used.
CONTAINER_DATABASE_URL=
CONTAINER_POSTGRES_HOST=host.docker.internal
DB_POOL_MODE=pooled
DB_POOL_SIZE=16
DB_MAX_OVERFLOW=48
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0
# Containers use the existing Redis published by your host.
CONTAINER_REDIS_URL=redis://host.docker.internal:6379/0
REDIS_HOST_PORT=6380
OPENAI_API_KEY=
# Optional; needed only by routes using provider=anthropic (Claude).
ANTHROPIC_API_KEY=
# Required only for collection_mode=tavily. No real-provider calls run in default tests.
TAVILY_API_KEY=
TAVILY_REQUEST_TIMEOUT_SECONDS=30
TAVILY_MAX_RESULTS=5
# Capped by MAX_STEP_ATTEMPTS; uncertain paid requests require explicit admin retry.
COLLECT_MAX_ATTEMPTS=2
OPENAI_MODEL=gpt-4.1-mini
# Empty keeps the existing OpenAI configuration for all three LLM steps.
# JSON is operator-only. See docs/llm-routing.vi.md and examples/llm-routing/.
LLM_ROUTING_JSON=
# Optional Ollama connection; no server or model is required for OpenAI/Claude routes.
OLLAMA_BASE_URL=http://localhost:11434
# Set to http://host.docker.internal:11434 when moving Ollama jobs into Docker Desktop.
# Keep API and worker on the same endpoint identity for new job snapshots.
CONTAINER_OLLAMA_BASE_URL=
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=90
MAX_LLM_CALLS_PER_JOB=3
MAX_AGENT_ITERATIONS=2
MAX_INPUT_CHARS=6000
MAX_OUTPUT_TOKENS_PER_STEP=500
MAX_ESTIMATED_USD_PER_JOB=0.20
# Estimates only; update rates when changing model (USD per million tokens).
INPUT_USD_PER_MILLION=0.40
OUTPUT_USD_PER_MILLION=1.60
LEASE_TTL_SECONDS=300
RECOVERY_SCAN_SECONDS=60
MAX_STEP_ATTEMPTS=3
ADMIN_TOKEN=
LOG_LEVEL=INFO
CREWAI_TELEMETRY_DISABLED=true
# Global tracing kill switch. Must be false to use Langfuse.
OTEL_SDK_DISABLED=false
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Include company text, prompts and outputs in traces only when wanted.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TIMEOUT_SECONDS=2
CREWAI_STORAGE_DIR=./data/crewai
# Development only: claim / request_started / response / checkpoint
FAILURE_POINT=
FAILURE_STEP=RESEARCH

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
